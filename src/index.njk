---
layout: base
title: Home
---

<h1>Welcome</h1>

<section>
  <h2 class="section-title">Articles <a href="/content/list/">all →</a></h2>
  {%- set articles = (collections.articles | reverse).slice(0, 5) %}
  {%- include "entries.njk" %}
</section>

<section>
  <h2 class="section-title">Tools</h2>
  <ul class="entries">
    {%- for tool in collections.tools | reverse %}
    <li>
      <span class="kind tag-tool" aria-hidden="true"></span>
      <a class="title" href="{{ tool.url }}">{{ tool.data.title }}</a>
      {%- if tool.data.description %}
      <span class="desc">{{ tool.data.description }}</span>
      {%- endif %}
    </li>
    {%- endfor %}
  </ul>
</section>
