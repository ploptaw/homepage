<!DOCTYPE html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{{ title }}{% if title != "Home" %} | {{ site.name }}{% endif %}</title>
    {%- set desc = description or site.description %}
    {%- set absUrl = site.url + page.url %}
    <meta name="description" content="{{ desc }}" />
    <meta name="theme-color" content="{{ site.themeColor }}" />
    <meta name="color-scheme" content="dark" />
    <link rel="canonical" href="{{ absUrl }}" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="apple-touch-icon" href="/icon-192x192.png" />
    <style>
      {%- css "base" %}
      {%- if layout in ["post", "tool"] %}{% css layout %}{% endif %}
      {%- if styles %}{% css styles %}{% endif %}
      {%- if "language-" in content %}{% css "prism" %}{% endif -%}
    </style>

    <meta property="og:title" content="{{ title }}" />
    <meta property="og:description" content="{{ desc }}" />
    <meta property="og:image" content="{{ site.url }}/icon-192x192.png" />
    <meta property="og:url" content="{{ absUrl }}" />
    <meta property="og:type" content="{{ 'article' if date and layout == 'post' else 'website' }}" />
  </head>
  <body>
    <header class="site-header">
      <nav class="site-nav">
        {%- set nav = [["home", "/"], ["list", "/content/list/"], ["gallery", "/content/gallery/"], ["about", "/content/about/"]] -%}
        {%- for item in nav %}
        <a href="{{ item[1] }}"{% if page.url == item[1] %} aria-current="page"{% endif %}>{{ item[0] }}</a>
        {%- endfor %}
        <a href="https://github.com/ploptaw">source ↗</a>
      </nav>
    </header>
    <main>
      {{ content | safe }}
    </main>
  </body>
</html>
