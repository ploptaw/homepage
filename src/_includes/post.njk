---
layout: base
---

<article>
  <header class="post-header">
    <h1>{{ title }}</h1>
    <div class="post-meta">
      <time datetime="{{ date | dateISO }}">{{ date | dateJP }}</time>
      {%- if tags %}
      <ul class="tags">
        {%- for tag in tags %}
        <li><a class="tag-{{ tag | slug }}" href="/tags/{{ tag | slug }}/">{{ tag }}</a></li>
        {%- endfor %}
      </ul>
      {%- endif %}
    </div>
  </header>
  <div class="prose">
    {{ content | safe }}
  </div>
</article>
